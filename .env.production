# Valores usados no BUILD DE PRODUÇÃO (npm run build / Vercel).
# Este arquivo VAI para o GitHub: nunca coloque senhas aqui.
#
# A URL real do backend deve ser cadastrada na Vercel:
#   Settings -> Environment Variables -> VITE_API_URL = https://SEU-BACKEND.up.railway.app
# Variáveis da Vercel têm prioridade sobre este arquivo.
# Depois de mudar uma variável na Vercel é preciso fazer um novo deploy (Redeploy).
#
# Para o modo de demonstração (dados de exemplo, sem backend): VITE_USE_MOCKS=true

VITE_USE_MOCKS=false
VITE_API_URL=https://SEU-BACKEND.up.railway.app
